{
  "manifest_version": 3,
  "name": "Atılım Moodle UI Fix",
  "version": "3.2.1",
  "description": "A calmer, more readable and more usable interface for moodle.atilim.edu.tr, for both students and teachers.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Atılım Moodle UI Fix"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle.atilim.edu.tr/*"
      ],
      "run_at": "document_start",
      "css": [
        "fonts/lato.css",
        "styles/base.css",
        "styles/layout.css",
        "styles/navbar.css",
        "styles/dashboard.css",
        "styles/course.css",
        "styles/courseindex.css",
        "styles/activity.css",
        "styles/forms.css",
        "styles/tables.css",
        "styles/messages.css",
        "styles/editmode.css",
        "styles/dark.css"
      ],
      "js": [
        "content/settings.js",
        "content/features.js",
        "content/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://moodle.atilim.edu.tr/*"
      ]
    }
  ]
}
